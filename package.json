{
  "name": "jellyfin-ios",
  "version": "1.8.0",
  "main": "index.js",
  "scripts": {
    "start": "expo start --dev-client",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "ios-device": "expo run:ios --device",
    "build": "expo prebuild --platform ios",
    "lint": "eslint \".\"",
    "test": "jest --watchAll",
    "postinstall": "patch-package"
  },
  "jest": {
    "preset": "jest-expo",
    "setupFiles": [
      "./jest.setup.js"
    ],
    "moduleNameMapper": {
      "@jellyfin/ux-ios/.+\\.png$": "<rootDir>/__mocks__/assetFileMock.js"
    },
    "transformIgnorePatterns": [
      "node_modules/(?!((jest-)?react-native|@react-native(-community)?)|expo(nent)?|@expo(nent)?/.*|react-navigation|@react-navigation/.*|@unimodules/.*|unimodules|sentry-expo|native-base|react-native-svg|normalize-url|axios|@jellyfin/sdk(/.*)?)"
    ],
    "collectCoverage": true,
    "collectCoverageFrom": [
      "**/*.{js,jsx,ts,tsx}",
      "!**/coverage/**",
      "!**/node_modules/**",
      "!**/babel.config.js",
      "!**/metro.config.js",
      "!**/jest.setup.js"
    ]
  },
  "browserslist": [
    "iOS > 11",
    "Android >= 5"
  ],
  "dependencies": {
    "@expo/vector-icons": "^15.0.2",
    "@jellyfin/sdk": "0.11.0",
    "@jellyfin/ux-ios": "1.0.0",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-masked-view/masked-view": "0.3.2",
    "@react-native-menu/menu": "1.2.4",
    "@react-navigation/bottom-tabs": "^7.0.0",
    "@react-navigation/native": "^7.0.0",
    "@react-navigation/native-stack": "^7.0.0",
    "@react-navigation/stack": "^7.0.0",
    "axios": "1.17.0",
    "compare-versions": "3.6.0",
    "expo": "56.0.9",
    "expo-application": "~56.0.3",
    "expo-asset": "~56.0.16",
    "expo-audio": "~56.0.11",
    "expo-constants": "~56.0.17",
    "expo-device": "~56.0.4",
    "expo-file-system": "~56.0.7",
    "expo-font": "~56.0.5",
    "expo-keep-awake": "~56.0.3",
    "expo-linking": "~56.0.13",
    "expo-localization": "~56.0.6",
    "expo-screen-orientation": "~56.0.5",
    "expo-sharing": "~56.0.16",
    "expo-splash-screen": "~56.0.10",
    "expo-status-bar": "~56.0.4",
    "expo-system-ui": "~56.0.5",
    "expo-video": "~56.1.2",
    "expo-web-browser": "~56.0.5",
    "i18next": "^23.16.0",
    "normalize-url": "7.2.0",
    "prop-types": "15.8.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-i18next": "^15.1.0",
    "react-lifecycles-compat": "3.0.4",
    "react-native": "0.85.3",
    "react-native-elements": "3.4.3",
    "react-native-gesture-handler": "~2.31.1",
    "react-native-get-random-values": "~1.11.0",
    "react-native-reanimated": "4.3.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "4.25.2",
    "react-native-url-polyfill": "1.3.0",
    "react-native-web": "^0.21.0",
    "react-native-webview": "13.16.1",
    "react-native-worklets": "0.8.3",
    "uuid": "11.1.1",
    "zustand": "5.0.14"
  },
  "devDependencies": {
    "@babel/core": "^7.18.6",
    "@babel/eslint-parser": "7.29.7",
    "@eslint-community/eslint-plugin-eslint-comments": "^4.4.1",
    "@eslint/js": "^9.18.0",
    "@react-native/jest-preset": "0.85.3",
    "@stylistic/eslint-plugin": "^2.13.0",
    "@testing-library/dom": "10.4.0",
    "@testing-library/jest-dom": "6.6.3",
    "@testing-library/react": "16.1.0",
    "@testing-library/react-native": "^13.2.0",
    "@types/jest": "^29.5.14",
    "@types/react": "~19.2.14",
    "babel-preset-expo": "~56.0.0",
    "eslint": "^9.18.0",
    "eslint-import-resolver-typescript": "4.4.4",
    "eslint-plugin-compat": "7.0.1",
    "eslint-plugin-import": "2.31.0",
    "eslint-plugin-jest": "^28.10.0",
    "eslint-plugin-promise": "^7.2.1",
    "eslint-plugin-react": "7.37.4",
    "globals": "^15.14.0",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "jest-expo": "~56.0.4",
    "jest-fetch-mock": "3.0.3",
    "node-abort-controller": "3.1.1",
    "patch-package": "8.0.1",
    "ts-jest": "^29.4.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.20.0"
  },
  "private": true,
  "overrides": {
    "react-test-renderer": "19.2.3"
  },
  "engines": {
    "node": ">=20.0.0",
    "yarn": "YARN NO LONGER USED - use npm instead."
  }
}
