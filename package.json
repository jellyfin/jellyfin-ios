{
  "name": "jellyfin-ios",
  "version": "1.8.0",
  "main": "node_modules/expo/AppEntry.js",
  "scripts": {
    "start": "expo start --dev-client",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "build": "expo prebuild --platform ios",
    "lint": "eslint \".\"",
    "test": "jest --watchAll"
  },
  "jest": {
    "preset": "jest-expo",
    "setupFiles": [
      "./jest.setup.js"
    ],
    "setupFilesAfterEnv": [
      "@testing-library/jest-native/extend-expect"
    ],
    "moduleNameMapper": {
      "@jellyfin/ux-ios/.+\\.png$": "<rootDir>/__mocks__/assetFileMock.js"
    },
    "transformIgnorePatterns": [
      "node_modules/(?!((jest-)?react-native|@react-native(-community)?)|expo(nent)?|@expo(nent)?/.*|react-navigation|@react-navigation/.*|@unimodules/.*|unimodules|sentry-expo|native-base|react-native-svg|normalize-url|axios|@jellyfin/sdk(/.*)?)"
    ],
    "collectCoverage": true,
    "collectCoverageFrom": [
      "**/*.{js,jsx,ts,tsx}",
      "!**/coverage/**",
      "!**/node_modules/**",
      "!**/babel.config.js",
      "!**/metro.config.js",
      "!**/jest.setup.js"
    ],
    "testEnvironment": "jsdom"
  },
  "browserslist": [
    "iOS > 11",
    "Android >= 5"
  ],
  "dependencies": {
    "@jellyfin/sdk": "0.11.0",
    "@jellyfin/ux-ios": "1.0.0",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-masked-view/masked-view": "0.3.2",
    "@react-native-menu/menu": "1.2.4",
    "@react-navigation/bottom-tabs": "6.6.1",
    "@react-navigation/native": "6.1.18",
    "@react-navigation/native-stack": "6.11.0",
    "@react-navigation/stack": "6.4.1",
    "axios": "1.9.0",
    "compare-versions": "3.6.0",
    "expo": "^54",
    "expo-application": "~7.0.8",
    "expo-asset": "~12.0.12",
    "expo-av": "~16.0.8",
    "expo-build-properties": "~1.0.10",
    "expo-constants": "~18.0.13",
    "expo-device": "~8.0.10",
    "expo-file-system": "~19.0.21",
    "expo-font": "~14.0.11",
    "expo-keep-awake": "~15.0.8",
    "expo-linking": "~8.0.11",
    "expo-localization": "~17.0.8",
    "expo-screen-orientation": "~9.0.8",
    "expo-sharing": "~14.0.8",
    "expo-splash-screen": "~31.0.13",
    "expo-status-bar": "~3.0.9",
    "expo-system-ui": "~6.0.9",
    "expo-web-browser": "~15.0.10",
    "i18next": "21.10.0",
    "normalize-url": "7.2.0",
    "prop-types": "15.8.1",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-i18next": "11.18.6",
    "react-native": "0.81.5",
    "react-native-elements": "3.4.3",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-get-random-values": "~1.11.0",
    "react-native-reanimated": "~4.1.1",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-url-polyfill": "1.3.0",
    "react-native-web": "^0.21.0",
    "react-native-webview": "13.15.0",
    "react-native-worklets": "0.5.1",
    "uuid": "8.3.2",
    "zustand": "5.0.5"
  },
  "devDependencies": {
    "@babel/core": "^7.18.6",
    "@babel/eslint-parser": "7.26.8",
    "@testing-library/dom": "10.4.0",
    "@testing-library/jest-dom": "6.6.3",
    "@testing-library/jest-native": "5.4.3",
    "@testing-library/react": "16.1.0",
    "@testing-library/react-native": "12.9.0",
    "@types/jest": "29.5.14",
    "@types/react": "~19.1.10",
    "@types/uuid": "8.3.4",
    "@typescript-eslint/eslint-plugin": "5.62.0",
    "@typescript-eslint/parser": "4.33.0",
    "babel-preset-expo": "~54.0.10",
    "domexception": "4.0.0",
    "eslint": "7.32.0",
    "eslint-import-resolver-typescript": "4.4.4",
    "eslint-plugin-compat": "3.13.0",
    "eslint-plugin-eslint-comments": "3.2.0",
    "eslint-plugin-import": "2.31.0",
    "eslint-plugin-jest": "24.7.0",
    "eslint-plugin-promise": "5.2.0",
    "eslint-plugin-react": "7.37.4",
    "eslint-plugin-react-native": "3.11.0",
    "jest": "~29.7.0",
    "jest-environment-jsdom": "~29.7.0",
    "jest-expo": "~54.0.17",
    "jest-fetch-mock": "3.0.3",
    "node-abort-controller": "3.1.1",
    "ts-jest": "~29.3.0",
    "typescript": "~5.9.2"
  },
  "private": true,
  "engines": {
    "node": ">=20.0.0",
    "yarn": "YARN NO LONGER USED - use npm instead."
  }
}
